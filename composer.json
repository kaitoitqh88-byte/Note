{
    "name": "myvendor/cloudflare-php-project",
    "description": "A PHP project to interact with the Cloudflare API.",
    "version": "1.0.0",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "phpseclib/phpseclib": "^3.0",
        "google/apiclient": "^2.19"
    },
    "autoload": {
        "files": [
            "config.php",
            "CloudflareAPI.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Developer",
            "email": "developer@example.com"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000"
    }
}
