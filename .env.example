# Copy file này thành .env và điền thông tin của bạn

# Cloudflare Account Email
CLOUDFLARE_EMAIL=your-email@example.com

# Cloudflare API Token (có thể để trong file token.txt hoặc đây)
CLOUDFLARE_API_TOKEN=your_api_token_here

# Database (nếu cần mở rộng sau này)
DB_HOST=localhost  
DB_USER=root
DB_PASS=
DB_NAME=cloudflare_project

# Debug mode
DEBUG=true

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# Telegram VPS Interaction Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
VPS_DOMAIN_PATHS=/www/server/panel/vhost/nginx,/www/server/panel/vhost/apache,/www/server/panel/vhost/openlitespeed
TELEGRAM_INSECURE_SSL=false

# Optional CA bundle path for cURL on Windows (example):
# CURL_CA_BUNDLE=C:\\certs\\cacert.pem